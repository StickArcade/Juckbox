#!/bin/bash
# Servico do jukebox para Batocera.
#
# ATENCAO: Batocera NAO usa systemd (e buildroot + busybox init).
# Corrigindo o que eu disse antes: nao adianta criar um arquivo .service.
# O caminho certo e este script em /userdata/system/services/ , habilitado com:
#
#   cp servico-jukebox /userdata/system/services/jukebox
#   chmod +x /userdata/system/services/jukebox
#   batocera-services enable jukebox
#   batocera-services start  jukebox
#
# O supervisor abaixo e o que substitui o Restart=always do systemd: se o
# python morrer as 3 da manha, ele volta sozinho em vez de deixar a maquina
# parada ate alguem perceber no dia seguinte.

BASE=/userdata/system/.dev/apps/Juckbox
LOG=/userdata/system/.dev/supervisor.log
PIDFILE=/var/run/jukebox-supervisor.pid

registrar() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') $*" >> "$LOG"
    # log limitado a ~1 MB para nao encher o cartao
    if [ -f "$LOG" ] && [ "$(stat -c%s "$LOG")" -gt 1048576 ]; then
        mv "$LOG" "$LOG.1"
    fi
}

supervisor() {
    local espera=2
    registrar "supervisor iniciado"
    while true; do
        registrar "subindo o jukebox"
        cd "$BASE" || { registrar "ERRO: $BASE nao existe"; sleep 30; continue; }
        python3 "$BASE/jukebox"
        local codigo=$?

        if [ $codigo -eq 0 ]; then
            registrar "saida limpa (codigo 0) - supervisor encerrando"
            break
        fi

        registrar "jukebox caiu com codigo $codigo - reiniciando em ${espera}s"
        sleep "$espera"
        # backoff: evita loop de reinicio a 100% de CPU se o erro for permanente
        espera=$(( espera * 2 ))
        [ "$espera" -gt 60 ] && espera=60
    done
}

case "$1" in
    start)
        mkdir -p "$(dirname "$LOG")"
        supervisor &
        echo $! > "$PIDFILE"
        ;;
    stop)
        [ -f "$PIDFILE" ] && kill "$(cat "$PIDFILE")" 2>/dev/null
        rm -f "$PIDFILE"
        pkill -f "$BASE/jukebox"
        pkill -f "input-ipc-server=/tmp/jukebox-mpv.sock"
        registrar "servico parado"
        ;;
    restart)
        "$0" stop; sleep 2; "$0" start
        ;;
    status)
        if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
            echo "rodando (supervisor pid $(cat "$PIDFILE"))"
        else
            echo "parado"
        fi
        ;;
    *)
        echo "uso: $0 {start|stop|restart|status}"
        exit 1
        ;;
esac
