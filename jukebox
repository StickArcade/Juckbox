def abrir_gerenciador_arquivos():
    """Abre o gerenciador de arquivos por cima da interface, como o F1 do
    EmulationStation. Nao encerra o jukebox nem destroi a janela:

     - destruir a janela invalidaria todos os caches (fundo, cartoes, fontes)
     - travar o laco pararia a fila; se a musica acabasse com o gerenciador
       aberto, o cliente ficaria sem o que pagou

    Como nao ha gerenciador de janelas, quem abre por ultimo fica na frente."""
    global processo_arquivos
    if processo_arquivos and processo_arquivos.poll() is None:
        return
    programa = OPER.get("gerenciador_arquivos", "pcmanfm")
    if not shutil.which(programa):
