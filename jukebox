# ======================================================================
# [FIX] LISTAGEM COM CACHE
# Antes: os.listdir a cada navegacao. Com biblioteca grande e cartao SD isso
# trava a interface. Agora a listagem e cacheada e so refeita se a pasta mudou
# ou passou o tempo configurado.
# ======================================================================
_cache_listagem = {}


def _listar(caminho, filtro_pasta):
    agora = time.time()
    chave = (caminho, filtro_pasta)
    entrada = _cache_listagem.get(chave)
    if entrada and agora - entrada[0] < OPER["segundos_cache_diretorio"]:
        return entrada[1]
    try:
        itens = os.listdir(caminho)
        if filtro_pasta:
            resultado = sorted(d for d in itens
                               if os.path.isdir(os.path.join(caminho, d)))
        else:
            resultado = sorted(f for f in itens
                               if f.lower().endswith(EXTENSOES))
    except OSError as erro:
        LOG.warning("nao listou %s: %s", caminho, erro)
        resultado = []
