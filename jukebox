        LOG.info("gerenciador de arquivos aberto: %s em %s", programa, pasta)
    except OSError as erro:
        LOG.error("nao abriu o gerenciador: %s", erro)
        processo_arquivos = None


def recuperar_foco():
    """Traz o jukebox de volta a frente.

    Com video_embutido=false o mpv abre janela propria; quando ela fecha, o
    Openbox devolve o foco para a ULTIMA janela que o teve -- que pode ser o
    navegador, o terminal, qualquer coisa. O jukebox fica vivo atras,
    esperando eventos que nao chegam, e parece travado.

    windowactivate apenas PEDE o foco, sem alterar propriedades da janela --
    diferente de windowunmap e skip_taskbar, que travaram a sessao.

    [FIX] Uma tentativa so, as vezes, perde a corrida. O rc.xml do Batocera
    forca toda janela "normal" (jukebox, pcmanfm, mpv) a ficar fullscreen
    sem borda; quando a de cima fecha, o Openbox tem sua PROPRIA logica
    interna de para-quem-devolver-o-foco, e ela roda em paralelo com o
    nosso pedido -- as vezes DEPOIS, desfazendo o windowactivate calado (o
    log dizia "foco devolvido" e a janela continuava atras). Reproduzido a
    mao: um windowactivate isolado ora colava, ora nao, dependendo de quao
    rapido o Openbox ainda estava fechando a janela anterior. Repetir por
    ~1.5s garante que a ULTIMA tentativa, feita com a poeira ja baixada,
    vença essa disputa. Roda numa thread a parte: so chama xdotool, nao
    toca em fila/estado/tela, entao nao precisa do laco principal para
    agir com seguranca."""
    if not OPER.get("recuperar_foco", True):
        return
    if not JANELA_ID:
        LOG.warning("sem id da janela - nao da para recuperar o foco")
        return
    if not shutil.which("xdotool"):
        LOG.warning("xdotool ausente - nao da para recuperar o foco")
        return

    def _insistir():
        # sem --sync e sem esperar: o --sync BLOQUEIA ate a janela ficar
        # ativa, e isso teria que rodar fora do laco principal mesmo assim
        atrasos = (0.0, 0.15, 0.35, 0.6, 1.0, 1.5)
        anterior = 0.0
        for alvo in atrasos:
            time.sleep(alvo - anterior)
            anterior = alvo
            try:
                subprocess.call(["xdotool", "windowactivate", str(JANELA_ID)],
                                stdout=subprocess.DEVNULL,
                                stderr=subprocess.DEVNULL)
            except Exception as erro:
                LOG.warning("nao recuperei o foco: %s", erro)
                return

    threading.Thread(target=_insistir, daemon=True).start()
    LOG.info("foco devolvido ao jukebox (insistindo por 1.5s)")


