# [FIX] CACHE DE FONTES E TEXTOS
# Antes: pygame.font.SysFont(None, 60) era criado a cada frame, e cada texto
# era rasterizado 30-60x por segundo sem nunca mudar. Agora fonte e texto sao
# criados uma vez e reaproveitados.
# ======================================================================
_fontes = {}
_textos = {}
LIMITE_CACHE_TEXTO = 600


def _tentar_fonte_arquivo(caminho, tamanho):
    """[FIX] pygame.font.Font() ACEITA um .ttf vazio ou corrompido sem
    reclamar -- o erro so aparece la na frente, no render(), como
    'Passed a NULL pointer'. Por isso nao basta os.path.exists():
    e preciso fazer um render de teste aqui para saber se a fonte presta."""
    try:
        if os.path.getsize(caminho) == 0:
            return None
        f = pygame.font.Font(caminho, tamanho)
        f.render("teste", True, (255, 255, 255))
        return f
    except (pygame.error, OSError, ValueError):
        return None


_avisou_fonte = False


def fonte(tamanho):
    global _avisou_fonte
    if tamanho not in _fontes:
        f = None
        if os.path.exists(FONTE_PATH):
            f = _tentar_fonte_arquivo(FONTE_PATH, tamanho)
            if f is None and not _avisou_fonte:
                LOG.warning("fonte %s invalida ou vazia - usando a fonte do "
                            "sistema", FONTE_PATH)
                _avisou_fonte = True
        _fontes[tamanho] = f or pygame.font.SysFont(None, tamanho)
    return _fontes[tamanho]


def texto(conteudo, tamanho, cor):
    chave = (conteudo, tamanho, tuple(cor))
    if chave not in _textos:
        if len(_textos) > LIMITE_CACHE_TEXTO:
            _textos.clear()          # evita crescer sem limite em 16h de uso
        _textos[chave] = fonte(tamanho).render(conteudo, True, tuple(cor))
    return _textos[chave]


