def acao_do_evento(evento):
    """Traduz teclado e controle para as mesmas acoes logicas."""
    if evento.type == pygame.KEYDOWN:
        return {pygame.K_UP: "cima", pygame.K_DOWN: "baixo",
                pygame.K_LEFT: "esquerda", pygame.K_RIGHT: "direita",
                pygame.K_RETURN: "ok", pygame.K_KP_ENTER: "ok",
                pygame.K_ESCAPE: "voltar"}.get(evento.key)
    if evento.type == pygame.JOYHATMOTION:
        x, y = evento.value
        if y == 1:
            return "cima"
        if y == -1:
            return "baixo"
        if x == -1:
            return "esquerda"
        if x == 1:
            return "direita"
    if evento.type == pygame.JOYBUTTONDOWN:
        if evento.button in (0, 1):
            return "ok"
        # [FIX] o botao START tambem marca pra playlist (mesma acao da
        # seta DIREITA) -- cabines sem D-pad de verdade so tem botao. O
        # numero varia por controle; ajustavel em
        # operacao.botao_start_joystick se nao for o padrao (7). Qualquer
        # botao FORA do conhecido fica no log, pra achar o numero certo
        # sem precisar adivinhar.
        if evento.button == OPER.get("botao_start_joystick", 7):
            return "direita"
        LOG.info("botao de joystick nao mapeado: %d", evento.button)
        return "voltar"
    return None


def processar(acao):
    global estado, sel_genero, sel_artista, sel_musica, genero_atual, artista_atual
    global artistas, musicas, cursor_x, montando_fila, limite_fila
    global musica_atual_nome, alvo_genero, alvo_artista, pos_artista
    global contagem_inicio, genero_tocando

    if acao == "voltar":
        tocar_efeito(SOM_VOLTAR)
        if estado == "menu_artista":
            estado = "menu_genero"
        elif estado == "menu_musica":
            estado = "menu_artista"
        elif estado == "playing":
            player.stop()                 # [FIX] agora nao dispara on_finish
            encerrar_reproducao()
            cursor_x = 0
        return

    # Nos niveis de carrossel a navegacao e HORIZONTAL; cima/baixo passam a
    # alternar entre o carrossel e o botao lateral.
    if acao in ("esquerda", "direita"):
        passo = -1 if acao == "esquerda" else 1
        if estado == "menu_genero" and cursor_x == 0:
            tocar_efeito(SOM_MOVER)
            alvo_genero += passo
        elif estado == "menu_artista":
            tocar_efeito(SOM_MOVER)
            alvo_artista += passo
        elif estado == "menu_musica":
            cursor_x = 0        # sem botao nesta tela desde que o PLAY saiu
        return

    if acao in ("cima", "baixo"):
        passo = -1 if acao == "cima" else 1
        if estado == "menu_musica" and cursor_x == 0:
            tocar_efeito(SOM_MOVER)
            sel_musica += passo
        elif estado == "menu_genero" and cursor_x == 1:
            # nao ha mais botao nesta tela, mas se algo deixar o cursor preso
            # aqui, cima/baixo continua sendo uma saida
            tocar_efeito(SOM_MOVER)
            cursor_x = 0
        return

    if acao != "ok":
        return

    if creditos_disponiveis <= 0:
        tocar_efeito(SOM_VOLTAR)
        return

    if estado == "menu_genero" and generos:
        # o modo playlist agora e automatico; aqui so se entra no genero
        tocar_efeito(SOM_SELECIONAR)
        genero_atual = generos[sel_genero % len(generos)]
        artistas = artistas_validos(genero_atual)
        sel_artista = 0
        alvo_artista = 0
        pos_artista = 0.0
        estado = "menu_artista"

    elif estado == "menu_artista" and artistas:
        tocar_efeito(SOM_SELECIONAR)
        artista_atual = artistas[sel_artista % len(artistas)]
        musicas = listar_musicas(
            os.path.join(MUSIC_PATH, genero_atual, artista_atual))
        sel_musica = 0
        estado = "menu_musica"

    elif estado == "menu_musica" and musicas:
        arquivo = musicas[sel_musica % len(musicas)]
        caminho = os.path.join(MUSIC_PATH, genero_atual, artista_atual, arquivo)
        nome = os.path.splitext(arquivo)[0]
        if youtube.eh_busca(caminho):
            # arquivo marcador: abre a busca em vez de tocar. Nada e cobrado
            # aqui -- so quando o cliente escolher um video.
            tocar_efeito(SOM_SELECIONAR)
            abrir_busca()
            return
        if eh_playlist(caminho):
            # .m3u: uma "musica" da lista que na verdade abre VARIAS.
            # Credito continua sendo cobrado 1 por 1, do mesmo jeito de
            # sempre -- so a primeira entra tocando na hora, o resto vai
            # pra fila e emenda sozinho pelo tocar_proxima() de sempre.
            itens_playlist = ler_playlist(caminho)
            if not itens_playlist:
                tocar_efeito(SOM_VOLTAR)
                return
            if montando_fila:
                tocar_efeito(SOM_SELECIONAR)
                for item_caminho, item_nome in itens_playlist:
                    if len(fila) >= limite_fila:
                        break
                    fila.append((item_caminho, item_nome))
                salvar_fila(fila)
            else:
                primeiro_caminho, primeiro_nome = itens_playlist[0]
                if creditos.consumir(OPER["creditos_por_musica"],
                                     "playlist: " + primeiro_nome):
                    atualizar_creditos(creditos.ler())
                    if tocar_caminho(primeiro_caminho):
                        musica_atual_nome = primeiro_nome
                        genero_tocando = genero_do_caminho(primeiro_caminho)
                        estado = "playing"
                        fila.extend(itens_playlist[1:])
                        salvar_fila(fila)
                    else:
                        creditos.devolver(OPER["creditos_por_musica"],
                                          "falha ao tocar: " + primeiro_nome)
                        atualizar_creditos(creditos.ler())
            return
        if montando_fila:
            if cursor_x == 0 and len(fila) < limite_fila:
                tocar_efeito(SOM_SELECIONAR)
                fila.append((caminho, nome))
                salvar_fila(fila)
            elif cursor_x == 1 and fila:
                tocar_proxima()
        else:
            if creditos.consumir(OPER["creditos_por_musica"], "avulsa: " + nome):
                atualizar_creditos(creditos.ler())
                if tocar_caminho(caminho):
                    musica_atual_nome = nome
                    genero_tocando = genero_do_caminho(caminho)
                    estado = "playing"
                else:
                    creditos.devolver(OPER["creditos_por_musica"],
                                      "falha ao tocar: " + nome)
                    atualizar_creditos(creditos.ler())


# ======================================================================
# LOOP PRINCIPAL
# [FIX] try/except em volta de tudo: um nome de arquivo estranho ou uma pasta
# removida durante o uso nao pode derrubar a tela e expor o terminal.
# ======================================================================
fila_preparo = list(generos)
LOG.info("jukebox iniciado - %dx%d", LARGURA, ALTURA)
# O saldo sobrevive a desligamento: fica no contador.txt, gravado de forma
# atomica. Registrar no boot e o que permite ao operador conferir, ao chegar
# no ponto, com quanto a maquina acordou.
LOG.info("saldo recuperado da sessao anterior: %d credito(s)", creditos_disponiveis)
if fila:
    LOG.info("fila pendente recuperada: %d musica(s) ja pagas", len(fila))
rodando = True
erros_consecutivos = 0
codigo_saida = 0
ultimo_repintar = 0.0

while rodando:
    try:
        agora = time.time()
        # [FIX] o contador era lido do disco a cada frame (60x/s, 16h por dia).
        # Agora e lido 2x por segundo.
        if agora - ultimo_check_credito > 0.5:
            # pega moeda inserida por fora (moedeiro) sem esperar acao do usuario
            atualizar_creditos(creditos.ler())
            ultimo_check_credito = agora

        # mantem redesenhando enquanto o contador esta piscando
        if agora < credito_destaque_ate:
            precisa_desenhar = True

        # Gerenciador de arquivos aberto por cima: o laco continua girando
        # (a fila precisa andar), mas nao desenhamos nem aceitamos navegacao.
        if processo_arquivos is not None:
            if processo_arquivos.poll() is None:
                # [FIX] NAO tocar na fila de eventos do SDL aqui.
                # Com a janela coberta pelo gerenciador, o pygame.event.get()
                # bloqueava e o laco nunca voltava a avaliar o poll() -- o
                # jukebox ficava no limbo mesmo depois do pcmanfm fechar.
                # Dormir direto e o unico jeito seguro: nao dependemos do SDL
                # para nada enquanto a outra janela esta na frente.
                time.sleep(0.25)
                precisa_desenhar = False
                continue
            LOG.info("gerenciador fechado - voltando ao jukebox")
            recuperar_foco()      # sobe na hora, sem esperar o WM decidir
            registrar_janelas("depois do F1")

            # recria a tela exatamente como no arranque
            if OPER.get("fechar_tela_no_f1", True):
                pygame.display.init()
                if TELA_CHEIA and UI.get("tela_sem_borda", True):
                    os.environ.setdefault("SDL_VIDEO_WINDOW_POS", "0,0")
                    tela = pygame.display.set_mode((LARGURA, ALTURA),
                                                   pygame.NOFRAME)
                elif TELA_CHEIA:
                    tela = pygame.display.set_mode((LARGURA, ALTURA),
                                                   pygame.FULLSCREEN)
                else:
                    tela = pygame.display.set_mode((LARGURA, ALTURA))
                definir_icone()
                pygame.display.set_caption("Jukebox")
                # os desenhistas guardam a superficie antiga: precisam da nova
                carrossel.tela = tela
                fundo.tela = tela
                menu.tela = tela
                tela_busca.tela = tela
                _textos.clear()
                LOG.info("tela recriada")
            processo_arquivos = None
            if (OPER.get("esconder_no_altab", False)
                    and JANELA_ID and shutil.which("xdotool")):
                subprocess.call(["xdotool", "windowmap", str(JANELA_ID)])
                subprocess.call(["xdotool", "windowactivate", str(JANELA_ID)])
            # devolve o ponteiro escondido e o unclutter como estava
            pygame.mouse.set_visible(not TELA_CHEIA)
            if comando_unclutter:
                try:
                    subprocess.Popen(comando_unclutter)
                    LOG.info("unclutter restaurado")
                except OSError as erro:
                    LOG.warning("nao restaurei o unclutter: %s", erro)
                comando_unclutter = None
            _textos.clear()
            precisa_desenhar = True

        for evento in pygame.event.get():
            if evento.type == pygame.QUIT:
                rodando = False
            elif evento.type == pygame.KEYDOWN and evento.key == pygame.K_q \
                    and (evento.mod & pygame.KMOD_CTRL) and (evento.mod & pygame.KMOD_SHIFT):
                LOG.info("saida manual por Ctrl+Shift+Q")
                rodando = False
            elif (OPER.get("credito_por_tecla", False)
                    and evento.type == pygame.KEYDOWN
                    and evento.key in TECLAS_CREDITO):
                # Atalho de TESTE, desligado no config de producao. O credito
                # entra na auditoria com origem propria, entao nunca se
                # mistura com a receita real no acerto do ponto.
                atualizar_creditos(creditos.adicionar(1, "tecla_teste"))
            elif (OPER.get("credito_por_tecla", False)
                    and evento.type == pygame.KEYDOWN
                    and evento.key in TECLAS_ZERAR):
                # So o SALDO. O totalizador e a referencia do acerto com o dono do
                # ponto -- se uma tecla pudesse apaga-lo, o numero nao valeria
                # nada. Para zerar o total: creditos.py zerar --tudo (por SSH).
                atualizar_creditos(creditos.zerar("tecla_teste"))
            elif (OPER.get("tecla_arquivos", False)
                    and evento.type == pygame.KEYDOWN
                    and evento.key == pygame.K_F1):
                abrir_gerenciador_arquivos()
            elif evento.type == EVENTO_BUSCA_PRONTA:
                if _achados:
                    tela_busca.receber_resultados(_achados[0], _achados[1])
                precisa_desenhar = True
            elif evento.type == EVENTO_CATALOGO_PRONTO:
                if _resultado_catalogo:
                    menu.mostrar_aviso(
                        "Catálogo: %d música(s), %d artista(s), %d gênero(s)"
                        % (_resultado_catalogo["musicas"],
                           _resultado_catalogo["artistas"],
                           _resultado_catalogo["generos"]), 3.5)
                    LOG.info("catalogo pronto: %s", _resultado_catalogo)
                else:
                    menu.mostrar_aviso("falha ao atualizar o catálogo (ver log)", 3.5)
                precisa_desenhar = True
            elif evento.type == EVENTO_LINK_PRONTO:
                resolvendo_link = False
                if _link_pronto:
                    video, audio = _link_pronto
                    if not player.play(video, on_finish=avisar_fim_da_musica,
                                       on_falha=avisar_falha_da_musica,
                                       audio_extra=audio):
                        avisar_falha_da_musica()
                else:
                    avisar_falha_da_musica()      # estorna e segue a fila
                precisa_desenhar = True
            elif evento.type == EVENTO_FALHA_MUSICA:
                # A faixa nem chegou a tocar. Devolve o credito e segue a fila:
                # arquivo com defeito nao pode travar a maquina nem comer o
                # dinheiro de quem pagou.
                creditos.devolver(OPER["creditos_por_musica"],
                                  "falha ao tocar: " + musica_atual_nome)
                atualizar_creditos(creditos.ler())
                musica_atual_nome = ""
                if fila:
                    tocar_proxima()
                else:
                    encerrar_reproducao()
                precisa_desenhar = True
            elif evento.type == EVENTO_FIM_MUSICA:
                # A musica acabou. Agora sim, na thread principal:
                # se ha fila, emenda a proxima; senao volta pro menu.
                if fila:
                    tocar_proxima()
                else:
                    encerrar_reproducao()
                precisa_desenhar = True
            elif (OPER.get("tecla_config", True)
                    and evento.type == pygame.KEYDOWN
                    and evento.key == pygame.K_F12):
                abrir_menu() if not menu.ativo() else menu.fechar()
                precisa_desenhar = True
            elif (menu.ativo() and menu.modo == "senha"
                    and evento.type == pygame.KEYDOWN
                    and evento.unicode.isdigit()):
                menu.digitar(evento.unicode)     # atalho pelo teclado
                precisa_desenhar = True
            elif (tela_busca.ativa and evento.type == pygame.KEYDOWN
                    and evento.unicode and evento.unicode.isprintable()):
                tela_busca.digitar(evento.unicode)
                precisa_desenhar = True
            else:
                acao = acao_do_evento(evento)
                if acao:
                    # com o menu aberto, ele consome a navegacao
                    if not menu.processar(acao):
                        if not tela_busca.processar(acao):
                            processar(acao)
                    precisa_desenhar = True

        # Saldo zerado fora da reproducao: volta para a tela inicial e
        # descarta a fila. Sem isso o cliente fica preso numa lista onde o
        # ENTER nao faz nada, e musicas escolhidas continuam na tela sem
        # credito que as pague.
        if (creditos_disponiveis <= 0 and estado != "playing"
                and (estado != "menu_genero" or fila)):
            LOG.info("saldo zerado - voltando para os generos")
            estado = "menu_genero"
            cursor_x = 0
            contagem_inicio = 0.0
            if fila:
                fila.clear()
                salvar_fila(fila)
            precisa_desenhar = True

        # ==============================================================
        # MODO PLAYLIST AUTOMATICO
        # Acima de um credito o cliente ja entra montando a fila. Antes ele
        # precisava descobrir sozinho um botao "CRIAR PLAYLIST" -- coisa que
        # ninguem faz num bar, com a maquina tocando alto e gente esperando.
        # ==============================================================
        deve_montar = creditos_disponiveis > 1 and estado != "playing"
        if deve_montar != montando_fila:
            montando_fila = deve_montar
            if not montando_fila:
                contagem_inicio = 0.0
            precisa_desenhar = True
        if montando_fila:
            # recalculado sempre: se cair mais moeda no meio da escolha, o
            # limite cresce na hora
            limite_fila = min(creditos_disponiveis, OPER["max_fila"])

        # Fila completa: toca sozinha depois da contagem. Sem isso a maquina
        # ficaria parada segurando credito ja pago se o cliente se distraisse.
        if montando_fila and fila and len(fila) >= limite_fila:
            if not contagem_inicio:
                contagem_inicio = time.time()
                LOG.info("fila completa (%d) - tocando em %ds",
                         len(fila), OPER.get("segundos_auto_play", 10))
            precisa_desenhar = True
            if time.time() - contagem_inicio >= OPER.get("segundos_auto_play", 10):
                contagem_inicio = 0.0
                tocar_proxima()
        elif contagem_inicio and not (montando_fila and fila):
            contagem_inicio = 0.0
        elif montando_fila and not contagem_inicio:
            precisa_desenhar = True      # mantem o pulso do aviso animando

        # [FIX] rede de seguranca: o cursor nunca pode ficar sobre um botao
        # que nao esta desenhado. Qualquer caminho novo que esqueca de zerar
        # o cursor e corrigido aqui, em vez de travar a maquina no bar.
        if cursor_x == 1:
            sem_botao = (
                estado == "menu_artista"
                or estado == "menu_genero"
                or (estado == "menu_musica" and not fila))
            if sem_botao:
                cursor_x = 0
                precisa_desenhar = True

        if generos:
            sel_genero = alvo_genero % len(generos)
        if artistas:
            sel_artista = alvo_artista % len(artistas)
        if musicas:
            sel_musica %= len(musicas)

        # animacao do carrossel: a posicao persegue o alvo com desaceleracao
        if estado in ("menu_genero", "menu_artista"):
            no_genero = estado == "menu_genero"
            alvo = alvo_genero if no_genero else alvo_artista
            atual = pos_genero if no_genero else pos_artista
            if abs(alvo - atual) > 0.003:
                atual += (alvo - atual) * 0.25
                if abs(alvo - atual) < 0.01:
                    atual = float(alvo)
                if no_genero:
                    pos_genero = atual
                else:
                    pos_artista = atual
                precisa_desenhar = True

        # Tocando, o fundo segue a MUSICA (a fila pode pular de forro para
        # samba). Parado, segue o carrossel -- e so com ele parado, porque
        # decodificar imagem a cada seta apertada engasgaria a navegacao.
        if estado == "playing":
            aplicar_fundo(genero_tocando)
        elif abs(alvo_genero - pos_genero) < 0.02:
            aplicar_fundo_do_genero()
        if fundo.em_transicao():
            precisa_desenhar = True

        # Com a maquina ociosa, prepara as miniaturas de fundo de um genero
        # por vez. Assim a primeira visita a cada genero ja encontra tudo
        # pronto, em vez de decodificar o PNG na frente do cliente.
        elif not precisa_desenhar and fila_preparo:
            g = fila_preparo.pop(0)
            fundo.preparar_miniatura("g:" + g, logo_de("g:" + g, [
                os.path.join(MUSIC_PATH, g, "logo"),
                os.path.join(CAMINHOS["base"], "assets", "logos", g),
            ]))
            if not fila_preparo:
                LOG.info("miniaturas de fundo preparadas")

        # Com credito na maquina, o halo neon do carrossel precisa respirar
        # mesmo com o cliente parado escolhendo -- do contrario o pulso
        # congela junto com a roleta (que so redesenha em movimento).
        if creditos_disponiveis > 0 and estado in ("menu_genero", "menu_artista"):
            precisa_desenhar = True

        # Com video em tela cheia por cima, redesenhar o pygame e trabalho
        # jogado fora: ninguem ve. Numa placa fraca isso e CPU que faz falta.
        if menu.ativo() or tela_busca.ativa:
            precisa_desenhar = True
        if estado == "playing" and getattr(player, "com_video", False):
            precisa_desenhar = False
        elif estado == "playing":
            scroll_x -= px(UI["velocidade_scroll"])
            if musica_atual_nome:
                largura_texto = texto(musica_atual_nome,
                                      UI["tamanho_fonte_lista"],
                                      UI["cor_normal"]).get_width()
                if scroll_x < -largura_texto:
                    scroll_x = LARGURA
            precisa_desenhar = True       # ha animacao, precisa redesenhar

        # [FIX] TELA PRETA APOS ALT+TAB
        # Redesenhar so quando algo muda economiza CPU, mas tem um buraco: se
        # a janela for coberta e reaparecer, o X descarta o conteudo e nada
        # avisa o programa. O resultado e tela preta com o jukebox vivo por
        # tras -- aconteceu 6 vezes em teste.
        #
        # Duas defesas. A primeira trata os eventos de janela do pygame 2,
        # que dizem exatamente "isto aqui precisa ser repintado".
        for _ev in pygame.event.get([
                getattr(pygame, "WINDOWEXPOSED", 0),
                getattr(pygame, "WINDOWRESTORED", 0),
                getattr(pygame, "WINDOWFOCUSGAINED", 0),
                getattr(pygame, "WINDOWSHOWN", 0),
                getattr(pygame, "WINDOWMAXIMIZED", 0)]):
            precisa_desenhar = True

        # A segunda e rede de seguranca: repinta de tempos em tempos mesmo
        # sem motivo. Custa ~10 ms a cada poucos segundos (o orcamento por
        # quadro e 33 ms), e garante que a maquina se recupere sozinha mesmo
        # por uma causa que nao previmos -- num bar nao ha ninguem para
        # apertar uma tecla.
        agora_repintar = time.time()
        if agora_repintar - ultimo_repintar >= OPER.get("repintar_a_cada", 3):
            ultimo_repintar = agora_repintar
            precisa_desenhar = True

        if precisa_desenhar:
            desenhar()
            precisa_desenhar = False

        relogio.tick(UI["fps"])
        erros_consecutivos = 0

    except Exception as erro:
        # [FIX] o try/except impediu o crash, mas o loop ficou girando e
        # repetindo o mesmo erro para sempre com a tela inutilizavel.
        # Depois de muitas falhas seguidas, sai com codigo 1 para o supervisor
        # reiniciar (o backoff dele evita loop de reinicio a 100% de CPU).
        erros_consecutivos += 1
        if erros_consecutivos == 1:
            LOG.exception("erro no loop principal: %s", erro)
        if erros_consecutivos >= 60:
            LOG.critical("60 falhas seguidas no loop - encerrando para o "
                         "supervisor reiniciar. Ultimo erro: %s", erro)
            codigo_saida = 1
            rodando = False
        time.sleep(0.5)
        precisa_desenhar = True

LOG.info("jukebox encerrado")
player.stop()
pygame.quit()
sys.exit(codigo_saida)
