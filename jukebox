def inicializar_acervo():
    """So mexe quando a pasta de musicas nao existe ou esta sem NENHUM
    genero -- se ja tem acervo (mesmo que so um genero), nunca toca em nada.

    Primeiro tenta extrair PACOTE_GENEROS (arvore real com logo/background,
    sem musica). Se o pacote nao existir, ou a extracao falhar (unsquashfs
    ausente, pacote corrompido), cai no fallback de sempre: generos padrao
    vazios, so para o carrossel nunca abrir zerado."""
    try:
        tem_genero = os.path.isdir(MUSIC_PATH) and any(
            os.path.isdir(os.path.join(MUSIC_PATH, d))
            for d in os.listdir(MUSIC_PATH))
    except OSError as erro:
        LOG.warning("nao consegui checar %s: %s", MUSIC_PATH, erro)
        return
    if tem_genero:
        return

    if os.path.isfile(PACOTE_GENEROS):
        try:
            os.makedirs(MUSIC_PATH, exist_ok=True)
            subprocess.run(
                ["unsquashfs", "-f", "-d", MUSIC_PATH, PACOTE_GENEROS],
                check=True, capture_output=True, text=True)
            LOG.info("acervo vazio -- %s extraido em %s",
                     os.path.basename(PACOTE_GENEROS), MUSIC_PATH)
            return
        except (subprocess.CalledProcessError, OSError, FileNotFoundError) as erro:
            LOG.warning("nao consegui extrair %s (%s) -- caindo para os "
                        "generos padrao vazios", PACOTE_GENEROS, erro)

    LOG.info("acervo vazio -- criando %d generos padrao + busca em %s",
             len(GENEROS_PADRAO), MUSIC_PATH)
    for nome in GENEROS_PADRAO:
        try:
            os.makedirs(os.path.join(MUSIC_PATH, nome, ARTISTA_PLACEHOLDER),
                        exist_ok=True)
        except OSError as erro:
            LOG.warning("nao criei o genero %s: %s", nome, erro)
    try:
        os.makedirs(os.path.join(MUSIC_PATH, GENERO_BUSCA), exist_ok=True)
    except OSError as erro:
        LOG.warning("nao criei o genero %s: %s", GENERO_BUSCA, erro)


def limpar_placeholders_de_artista():
    """Roda a cada boot: se um genero tem o placeholder E pelo menos um
    artista de verdade ao lado, o placeholder ja fez o papel dele (aparecer
    na lista antes de ter musica) e pode sumir sozinho."""
    try:
        nomes_genero = os.listdir(MUSIC_PATH)
    except OSError:
        return
    for nome_genero in nomes_genero:
        pasta_genero = os.path.join(MUSIC_PATH, nome_genero)
        pasta_placeholder = os.path.join(pasta_genero, ARTISTA_PLACEHOLDER)
        if not os.path.isdir(pasta_placeholder):
            continue
        try:
            tem_artista_real = any(
                d != ARTISTA_PLACEHOLDER
                and os.path.isdir(os.path.join(pasta_genero, d))
                for d in os.listdir(pasta_genero))
        except OSError:
            continue
        if not tem_artista_real:
            continue
        try:
            shutil.rmtree(pasta_placeholder)
            LOG.info("placeholder removido de %s (ja tem artista real)",
                     nome_genero)
        except OSError as erro:
            LOG.warning("nao consegui remover o placeholder de %s: %s",
                        nome_genero, erro)


