        return
    # A pasta usa o ARTISTA, nao o canal: canal costuma ser a gravadora
    # ("Oficina G3" publicado por "MK MUSIC") ou vir escrito errado.
    pasta = os.path.join(MUSIC_PATH, "YOUTUBE",
                         _nome_seguro(item.get("artista") or "Encontrados"))
    nome = item.get("musica") or item.get("titulo") or "sem nome"
    destino = os.path.join(pasta, _nome_seguro(nome) + ".url")
    if os.path.exists(destino):
        return
    try:
        os.makedirs(pasta, exist_ok=True)
        with open(destino, "w", encoding="utf-8") as f:
            f.write(item["url"] + "\n")
        LOG.info("busca guardada no acervo: %s", destino)
        _cache_listagem.clear()
        _cache_contagem.clear()
    except OSError as erro:
        LOG.warning("nao guardei a busca: %s", erro)


