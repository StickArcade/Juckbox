def ler_playlist(caminho):
    """Le um .m3u (extended ou simples) e devolve [(caminho, nome), ...],
    prontos pra entrar na fila do mesmo jeito que qualquer musica avulsa.

    Cada linha e um caminho local (relativo a PASTA DO M3U -- assim a
    playlist criada pelo menu, que grava .url e .m3u juntos na mesma pasta,
    continua funcionando se a pasta inteira for copiada pra outro lugar) ou
    um link http(s) direto. #EXTINF e opcional, so melhora o nome mostrado."""
    pasta = os.path.dirname(caminho)
    titulo_pendente = None
    itens = []
    try:
        with open(caminho, "r", encoding="utf-8", errors="ignore") as f:
            linhas = f.read().splitlines()
    except OSError as erro:
        LOG.warning("nao li a playlist %s: %s", caminho, erro)
        return itens
    for linha in linhas:
        linha = linha.strip()
        if not linha:
            continue
        if linha.startswith("#EXTINF:"):
            resto = linha.split(",", 1)
            titulo_pendente = resto[1].strip() if len(resto) > 1 else None
            continue
        if linha.startswith("#"):
            continue
        alvo = linha
        if not (alvo.startswith("http://") or alvo.startswith("https://")):
            if not os.path.isabs(alvo):
                alvo = os.path.join(pasta, alvo)
            if not os.path.exists(alvo):
                LOG.warning("playlist %s: item sumiu do disco: %s",
                           caminho, linha)
                titulo_pendente = None
                continue
        nome = titulo_pendente or os.path.splitext(os.path.basename(linha))[0]
        itens.append((alvo, nome))
        titulo_pendente = None
    return itens


