def carregar_config():
    caminho = os.environ.get("JUKEBOX_CONFIG", os.path.join(BASE, "config.json"))
    with open(caminho, "r", encoding="utf-8") as f:
        return json.load(f)


def montar_log(cfg):
    log = logging.getLogger("jukebox")
    log.setLevel(getattr(logging, cfg["log"]["nivel"], logging.INFO))
    formato = logging.Formatter(
        "%(asctime)s %(levelname)s %(message)s", "%Y-%m-%d %H:%M:%S")
    log.addHandler(logging.StreamHandler(sys.stdout))

    # [FIX] Nao dar para gravar o log NAO pode impedir a maquina de abrir.
    # Disco cheio, permissao errada, caminho de outro ambiente -- em qualquer
    # desses casos e melhor tocar musica sem log do que nao tocar nada.
    caminho = cfg["caminhos"]["log"]
    try:
        pasta = os.path.dirname(caminho)
        if pasta:
            os.makedirs(pasta, exist_ok=True)
        # log rotativo: sem isso o arquivo cresce sem limite e enche o cartao
        handler = logging.handlers.RotatingFileHandler(
            caminho, maxBytes=cfg["log"]["max_bytes"],
            backupCount=cfg["log"]["backups"], encoding="utf-8")
        handler.setFormatter(formato)
        log.addHandler(handler)
    except OSError as erro:
        log.warning("sem arquivo de log (%s): %s -- seguindo so pelo console",
                    caminho, erro)
    return log


