def _nome_arquivo_m3u(destino, base):
    """Nome do .m3u a partir do termo pesquisado (ex.: "COLDPLAY.m3u") em
    vez de so um carimbo de data -- fica reconhecivel so de olhar a pasta.
    Se ja existir um com esse nome (mesma busca exportada de novo), numera
    em vez de sobrescrever a playlist anterior."""
    base = _nome_seguro(base) or "playlist"
    candidato = base + ".m3u"
    n = 2
    while os.path.exists(os.path.join(destino, candidato)):
        candidato = "%s (%d).m3u" % (base, n)
        n += 1
    return candidato


def _finalizar_playlist(destino, itens_marcados, nome_base=None):
    """Grava um .url por musica marcada -- mesmo formato do guardar_busca(),
    entao tocar_caminho() ja sabe abrir sem mudar nada -- e um .m3u listando
    todos, na pasta que o operador escolheu no menu."""
    try:
        os.makedirs(destino, exist_ok=True)
    except OSError as erro:
        LOG.error("nao criei a pasta da playlist %s: %s", destino, erro)
        return "erro ao criar a pasta"

    linhas = ["#EXTM3U"]
    gravados = 0
    for item in itens_marcados:
        musica = item.get("musica") or item.get("titulo") or "sem nome"
        nome_arquivo = _nome_seguro(musica) + ".url"
        caminho_url = os.path.join(destino, nome_arquivo)
        if not os.path.exists(caminho_url):
            try:
                with open(caminho_url, "w", encoding="utf-8") as f:
                    f.write(item["url"] + "\n")
            except OSError as erro:
                LOG.warning("nao gravei %s: %s", caminho_url, erro)
                continue
        segundos = item.get("segundos") or 0
        linhas.append("#EXTINF:%d,%s" % (segundos, musica))
        linhas.append(nome_arquivo)
        gravados += 1

    if not gravados:
        return "nenhuma musica gravada"

    nome_m3u = _nome_arquivo_m3u(
        destino, nome_base or itens_marcados[0].get("artista") or "playlist")
    try:
        with open(os.path.join(destino, nome_m3u), "w", encoding="utf-8") as f:
            f.write("\n".join(linhas) + "\n")
    except OSError as erro:
        LOG.error("nao gravei o m3u em %s: %s", destino, erro)
        return "erro ao gravar o m3u"

    tela_busca.marcados.clear()
    _cache_listagem.clear()      # a pasta ganhou arquivos novos agora mesmo
    if len(menu.pilha) > 1 and menu.pilha[-1][0].startswith("_playlist_"):
        menu.pilha.pop()         # volta pra ACERVO, de onde veio
    LOG.info("playlist criada em %s: %d musica(s)", destino, gravados)
    return "Playlist criada: %d musica(s)" % gravados


def _resolver_pasta_playlist(genero, marcados, termo):
    """Acao de cada genero na lista: a pasta de destino e SEMPRE a do
    nome pesquisado (ex.: buscou "Fresno" -> MUSIC_PATH/<genero>/Fresno),
    nao mais uma lista de artistas pra escolher.

    [FIX] antes disto era uma segunda etapa com a lista de artistas
    daquele genero -- e o operador ja errou a linha nela (playlist de
    Coldplay foi parar em "Britney Spears"). Nomeando pelo termo
    pesquisado, so tem UM destino possivel por genero: nao existe, cria
    sozinho; ja existe, confirma mesclar em vez de sobrescrever/duplicar
    sem avisar."""
    nome_base = termo or (marcados[0].get("artista") if marcados else None) \
        or "Playlist"
    nome_pasta = _nome_seguro(nome_base)
    base_genero = os.path.join(MUSIC_PATH, genero)
    # [FIX] o termo pesquisado sempre vem em CAIXA ALTA do teclado virtual
    # (self.termo += caractere.upper()), mas uma pasta ja existente pode
    # ter capitalizacao normal ("Fresno", nao "FRESNO") -- seja porque foi
    # criada a mao ou por uma busca anterior salva pelo nome do artista.
    # Comparando so o nome exato, "FRESNO" e "Fresno" virariam pastas
    # DUPLICADAS em vez de mesclar. Aqui procura ignorando maiusculas.
    existente = next((p for p in listar_pastas(base_genero)
                      if p.lower() == nome_pasta.lower()), None)
    destino = os.path.join(base_genero, existente or nome_pasta)
    if existente:
        def _mesclar():
            return _finalizar_playlist(destino, marcados, nome_base=termo)
        menu.pedir_confirmacao(
            "Mesclar %d musica(s) em \"%s\"?" % (len(marcados), existente),
            _mesclar)
        return None
    return _finalizar_playlist(destino, marcados, nome_base=termo)


def abrir_escolha_pasta_playlist(termo=None):
    """Item de menu 'CRIAR PLAYLIST (M3U)'. O Menu so entende paginas
