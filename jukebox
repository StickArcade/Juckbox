def tocar_caminho(caminho):
    """Ponto unico para iniciar uma faixa.

    Arquivo local toca na hora. Link do YouTube precisa ser resolvido antes, e
    isso leva alguns segundos -- vai para uma thread, com BUSCANDO na tela, em
    vez de congelar a interface com o cliente olhando."""
    global resolvendo_link, _link_pronto
    # [FIX] Item vindo da busca entra na fila como URL, nao como arquivo. Sem
    # esta checagem ele ia direto para o mpv, que nao abre pagina do YouTube.
    if caminho.startswith("http://") or caminho.startswith("https://"):
        return tocar_link(caminho)
    if not youtube.eh_link(caminho):
        return player.play(caminho, on_finish=avisar_fim_da_musica,
                           on_falha=avisar_falha_da_musica)

    url = youtube.ler_url(caminho)
    if not url:
        LOG.error("arquivo de link sem URL dentro: %s", caminho)
        return False
    if not youtube.disponivel():
        LOG.error("yt-dlp nao instalado - link nao pode tocar")
        return False

    resolvendo_link = True
    _link_pronto = None

    def trabalhar():
        global _link_pronto
        try:
            _link_pronto = youtube.resolver(
                url, altura=OPER.get("altura_video", 720), logger=LOG)
        except Exception as erro:
            LOG.error("nao resolvi o link: %s", erro)
            _link_pronto = None
        try:
            pygame.event.post(pygame.event.Event(EVENTO_LINK_PRONTO))
        except pygame.error:
            pass

    threading.Thread(target=trabalhar, daemon=True).start()
    return True


def tocar_link(url):
    """Mesma resolucao do arquivo .url, mas com a URL ja em maos (veio da
    busca em vez de um arquivo)."""
    global resolvendo_link, _link_pronto
    resolvendo_link = True
    _link_pronto = None

    def trabalhar():
