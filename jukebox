def salvar_config():
    """Grava o config de volta, do mesmo jeito atomico do contador: temporario
    + fsync + rename. Config truncado por queda de energia deixaria a maquina
    sem subir."""
    caminho = os.environ.get("JUKEBOX_CONFIG", os.path.join(BASE, "config.json"))
    temporario = caminho + ".tmp"
    try:
        with open(temporario, "w", encoding="utf-8") as f:
            json.dump(CFG, f, ensure_ascii=False, indent=2)
            f.write("\n")
            f.flush()
            os.fsync(f.fileno())
        os.replace(temporario, caminho)
        return True
    except OSError as erro:
        LOG.error("nao gravei o config: %s", erro)
        return False


def interruptor(secao, chave, rotulo):
    """Devolve a acao de menu que inverte um booleano e grava. As secoes do
    config (OPER, UI...) sao o MESMO dicionario de CFG, entao mudar aqui ja
    vale para o resto do programa."""
    alvo = CFG[secao]

    def acao():
        alvo[chave] = not bool(alvo.get(chave, False))
        salvar_config()
        return "%s: %s" % (rotulo, "LIGADA" if alvo[chave] else "DESLIGADA")

    return acao


def estado_de(secao, chave):
    return lambda: "LIGADA" if CFG[secao].get(chave, False) else "DESLIGADA"


def item_numero(rotulo, secao, chave, minimo, maximo, passo=1,
                mostrar=None, aplicar=None):
    """Monta um item de menu ajustavel pelas setas laterais.

    Grava no config na hora e, quando faz sentido, aplica ja no sistema em
    vez de esperar o reinicio -- o operador precisa OUVIR o volume mudar
    enquanto mexe, senao regula no escuro."""
    alvo = CFG[secao]
    mostrar = mostrar or (lambda v: str(v))
    decimal = isinstance(passo, float)

    def ler():
        return mostrar(alvo.get(chave, minimo))

    def ajustar(direcao):
        atual = alvo.get(chave, minimo)
        novo = atual + direcao * passo
        novo = max(minimo, min(maximo, novo))
        novo = round(novo, 3) if decimal else int(novo)
        if novo == atual:
            return None                      # ja esta no limite
        alvo[chave] = novo
        if aplicar:
            try:
                aplicar(novo)
            except Exception as erro:
                LOG.warning("nao apliquei %s: %s", chave, erro)
        salvar_config()
        return "%s: %s" % (rotulo, mostrar(novo))

    return {"rotulo": rotulo, "valor": ler, "ajustar": ajustar}


