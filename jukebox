# [FIX] FUNDO PRE-COMPOSTO
# Antes: uma Surface de tela cheia (8 MB em 1080p) era alocada e descartada
# 60x por segundo. Agora fundo + overlay sao combinados uma unica vez.
# ======================================================================
def montar_fundo():
    superficie = pygame.Surface((LARGURA, ALTURA)).convert()
    superficie.fill((25, 25, 25))
    if os.path.exists(IMAGE_PATH):
        try:
            imagem = pygame.image.load(IMAGE_PATH).convert()
            # [FIX] antes esticava a imagem ate a tela, deformando tudo em
            # monitor de proporcao diferente. Agora cobre a tela mantendo a
            # proporcao e corta a sobra, centralizado.
            lo, ao = imagem.get_size()
            fator = max(LARGURA / lo, ALTURA / ao)
            escalada = pygame.transform.smoothscale(
                imagem, (int(lo * fator), int(ao * fator)))
            superficie.blit(escalada, escalada.get_rect(
                center=(LARGURA // 2, ALTURA // 2)))
        except pygame.error as erro:
            LOG.warning("nao carregou o fundo: %s", erro)
    escurecer = pygame.Surface((LARGURA, ALTURA)).convert()
    escurecer.set_alpha(UI["alpha_overlay"])
    escurecer.fill((0, 0, 0))
    superficie.blit(escurecer, (0, 0))
    return superficie


