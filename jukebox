def blit_direita(superficie, y, margem=40):
    """Alinha pela borda direita usando a largura real do texto -- funciona em
    qualquer resolucao, ao contrario de um 'LARGURA - 350' chutado."""
    tela.blit(superficie, (LARGURA - superficie.get_width() - px(margem), y))


def desenhar_lista(itens, indice, titulo):
    tam = px(UI["tamanho_fonte_lista"])
    tela.blit(texto(titulo, tam, UI["cor_selecionado"]),
              (px(100), TOPO_LISTA - px(100)))
    if not itens:
        return
    # o config vira apenas um teto; quem manda e o que cabe na tela
    visiveis = min(UI.get("itens_visiveis", 99), ITENS_VISIVEIS)
    inicio = max(0, min(indice - visiveis // 2, len(itens) - visiveis))
    for i, item in enumerate(itens[inicio:inicio + visiveis]):
        real = inicio + i
        cor = UI["cor_selecionado"] if real == indice else UI["cor_normal"]
        nome = os.path.splitext(item)[0]
        tela.blit(texto(nome, tam, cor), (px(120), TOPO_LISTA + i * LINHA_LISTA))


def desenhar_creditos():
    """Contador sempre visivel, em qualquer tela e qualquer resolucao."""
    em_destaque = time.time() < credito_destaque_ate
    # Tamanho FIXO: o destaque e so de cor. Antes o texto crescia 30% ao mudar
    # o saldo, e como ele e alinhado a direita isso fazia a linha inteira
    # dancar no canto a cada moeda.
    tamanho = px(UI.get("tamanho_fonte_creditos", UI["tamanho_fonte_botao"]))

    if creditos_disponiveis <= 0:
        cor = UI["cor_alerta"]
    elif em_destaque:
        cor = UI.get("cor_credito_destaque", UI["cor_ativo"])
    else:
        cor = UI["cor_selecionado"]

    blit_direita(texto("CRÉDITOS: %d" % creditos_disponiveis, tamanho, cor), px(25))


def desenhar_aviso_playlist():
    """Aviso de playlist: pulsa enquanto faltam musicas e vira contagem
    regressiva quando a fila completa. Aparece em todas as telas de escolha,
    porque o cliente precisa saber quantas ainda pode pegar enquanto navega."""
    if estado == "playing" or not montando_fila:
        return
    tam = px(UI["tamanho_fonte_botao"])

    if contagem_inicio:
        restante = int(OPER.get("segundos_auto_play", 10)
                       - (time.time() - contagem_inicio)) + 1
        blit_direita(texto("TOCANDO EM %ds" % max(0, restante), tam,
                           UI["cor_ativo"]), px(110))
        return

    # Pulso em degraus: a cor entra na chave do cache de texto, entao um
    # valor continuo criaria uma superficie nova por quadro. Seis degraus
    # dao um pulso suave reaproveitando seis entradas.
    fase = (math.sin(time.time() * 5.0) + 1.0) / 2.0
    degrau = int(fase * 5.999) / 5.0
    base = UI["cor_ativo"]
    cor = tuple(int(c * (0.35 + 0.65 * degrau)) for c in base)
    blit_direita(texto("CRIAR PLAYLIST  %d/%d" % (len(fila), limite_fila),
                       tam, cor), px(110))


