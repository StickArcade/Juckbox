def guardar_busca(item):
    """Toda escolha da busca vira um .url no acervo, na pasta do ARTISTA.

    Assim a maquina APRENDE: o que um cliente procurou hoje fica disponivel
    para o proximo sem precisar buscar de novo -- e sem os 4 segundos de
    espera, porque na proxima vez ja e um item normal da lista."""
