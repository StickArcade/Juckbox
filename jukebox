    # O unclutter esconde o ponteiro; sem ele o gerenciador fica inutilizavel.
    global comando_unclutter
    comando_unclutter = _capturar_unclutter()
    if comando_unclutter:
        subprocess.call(["pkill", "unclutter"])
        LOG.info("unclutter encerrado para liberar o ponteiro")
    pygame.mouse.set_visible(True)

    # Desmapeia a janela: ela some do Alt+Tab e da barra enquanto o
    # gerenciador esta aberto, como o EmulationStation faz. O processo
    # continua rodando normalmente (a fila anda, a musica toca).
